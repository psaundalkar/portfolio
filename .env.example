# =========================
# Vercel Environment Vars
# Copy this file to .env for local development (DO NOT commit .env)
# In Vercel: Project Settings -> Environment Variables
# =========================

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Email (pick ONE option) ---

# Option 1: Gmail (recommended for quick setup)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Option 2: Custom SMTP (uncomment and configure)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-smtp-password

# Optional sender/support details
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Prashant Saundalkar
SUPPORT_EMAIL=support@yourdomain.com

# --- Google Sheets (Enrollment logging) ---
# Spreadsheet ID from your link:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1jYB9QlNQS4-cmF7Kp6jzVD6UOmS-Ekay2EM2j9E1muA

# Service account credentials (from the downloaded JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# IMPORTANT:
# - In Vercel UI you can paste the private key as-is (multiline) or with \n
# - This code handles both by converting \n to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Sheet tabs (you created these tabs)
GOOGLE_SHEETS_TAB_DSLR=DSLR
GOOGLE_SHEETS_TAB_SMARTPHONE=Smartphone
